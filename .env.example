# ─────────────────────────────────────────────────────────────────────────────
# Dynacat — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Branding ──────────────────────────────────────────────────────────────────
# Label shown in the weather strip header
DASHBOARD_NAME=Mayolab

# ── Services widget ───────────────────────────────────────────────────────────
# Base domain used to build all docker-containers URLs: https://service.${BASE_DOMAIN}
BASE_DOMAIN=your-domain.example.com
# Internal services not on the base domain
LEMONADE_URL=http://YOUR_LEMONADE_IP:13305
OPENWEB_URL=http://YOUR_OPENWEB_IP:8088

# ── Pi-hole (v6) ──────────────────────────────────────────────────────────────
# Pi-hole v6 uses session-based auth; this widget requires a backend proxy that
# handles POST /api/auth and exposes plain GET endpoints.
# Base URL for each instance (include scheme, no trailing slash)
PIHOLE_1_URL=http://YOUR_PIHOLE_1_IP:PORT
PIHOLE_1_NAME=Pihole-Primary
# Web UI password (Settings → Web Interface → Set password)
PIHOLE_1_PASSWORD=your_pihole_1_webpassword
# Remove the second card block in pihole.yml if you only have one instance
PIHOLE_2_URL=http://YOUR_PIHOLE_2_IP:PORT
PIHOLE_2_NAME=Pihole-Secondary
PIHOLE_2_PASSWORD=your_pihole_2_webpassword

# ── Glance Agent (server-stats widget) ───────────────────────────────────────
# Run glance-agent on each remote host; the token is set in the agent config
STATS_LOCAL_NAME=HomeServer
STATS_SERVER_1_NAME=Server1
STATS_SERVER_1_URL=http://SERVER_1_IP:27973
STATS_SERVER_1_TOKEN=your_glance_agent_token
STATS_SERVER_2_NAME=Server2
STATS_SERVER_2_URL=http://SERVER_2_IP:27973
STATS_SERVER_2_TOKEN=your_glance_agent_token
# Remove this block in server-stats.yml if you have fewer than 3 remote servers
STATS_SERVER_3_NAME=Server3
STATS_SERVER_3_URL=http://SERVER_3_IP:27973
STATS_SERVER_3_TOKEN=your_glance_agent_token

# ── Weather proxy (weather-head.yml) ─────────────────────────────────────────
# Caching proxy that wraps Tomorrow.io (nowcast / 24h) and Open-Meteo (7-day).
# See .tmp/WEATHER_SETUP_COMPLETE.md for setup instructions.
WEATHER_PROXY_URL=http://YOUR_PROXY_IP:PORT

# ── Weather — Open-Meteo only (weather-head-openmeteo.yml) ───────────────────
# Used by the proxy-free alternative widget. No API key required.
# Find your coordinates at e.g. https://www.latlong.net/
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278

# ── Custom API proxy (TickTick, Calendar, Parcels) ────────────────────────────
# Reverse proxy that handles OAuth / session auth for these services.
# See config/widgets/TICKTICK_README.md and PARCEL_README.md for setup.
API_PROXY_URL=https://your-api-proxy.example.com

# ── Tautulli ─────────────────────────────────────────────────────────────────
TAUTULLI_IP=YOUR_TAUTULLI_IP
TAUTULLI_PORT=8181
# Settings → Web Interface → API key
TAUTULLI_API_KEY=your_tautulli_api_key
# Plex → Settings → Remote Access → Server ID (in the URL when browsing a library)
SERVER_ID=your_plex_server_id

# ── Miniflux ─────────────────────────────────────────────────────────────────
# Full base URL of your Miniflux instance (no trailing slash)
MINIFLUX_URL=https://your-miniflux.example.com
# Settings → API Keys → Create a new API key
MINIFLUX_API_KEY=your_miniflux_api_key

# ── Karakeep ─────────────────────────────────────────────────────────────────
# IP:PORT of your Karakeep instance (no scheme, no trailing slash)
KARAKEEP_URL=YOUR_KARAKEEP_IP:3000
# Settings → API Keys
KARAKEEP_API_KEY=your_karakeep_api_key

# ── UniFi ────────────────────────────────────────────────────────────────────
# IP of your UniFi console (UDM / UDM Pro / CloudGateway)
UNIFI_CONSOLE_IP=YOUR_UNIFI_IP
# Network → System → API → Create API Key
UNIFI_API_KEY=your_unifi_api_key

# ── Calendar (CalDAV, consumed by the API proxy) ─────────────────────────────
CALENDAR_URL=http://YOUR_CALDAV_SERVER/dav.php/calendars/USER/default/
CALENDAR_USER=your_caldav_username
CALENDAR_PASSWORD=your_caldav_password

# ── Plex (latest-media widget — disabled by default) ─────────────────────────
# Find your token: Plex Web → Account → any device URL contains X-Plex-Token
PLEX_TOKEN=your_plex_token

# ── Sonarr / Radarr (used by services widget links only) ─────────────────────
SONARR_PORT=8989
RADARR_PORT=7878
